{
  "name": "@portfolio/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "db:migrate": "tsx --env-file-if-exists=../../.env scripts/migrate-postgres.ts",
    "db:import-sqlite": "tsx --env-file-if-exists=../../.env scripts/import-sqlite-to-postgres.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@portfolio/agent": "workspace:*",
    "@portfolio/config": "workspace:*",
    "@portfolio/shared": "workspace:*",
    "@portfolio/tools": "workspace:*",
    "express": "^4.21.2",
    "jose": "^6.2.12",
    "pdf-lib": "1.17.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^25.9.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
