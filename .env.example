# OpenRouter (used by apps/api's Agent)
OPENROUTER_API_KEY=
OPENROUTER_MODEL_ID=~openai/gpt-luna-latest
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=Matheus's Portfolio Assistant

# Comma-separated browser origins permitted to call the API.
ALLOWED_ORIGINS=http://localhost:3000,https://matheusgalvao.com,https://www.matheusgalvao.com

# Agent loop limits (optional — both have working defaults)
MAX_AGENT_ITERATIONS=8
MAX_TOOL_CALLS=12
MAX_OUTPUT_TOKENS=4096

# Number of reverse proxies in front of the API (1 for Cloudflare/nginx).
# Required in production: without it, req.ip is the proxy address (everyone
# shares one rate-limit bucket) and direct connections can spoof
# X-Forwarded-For to rotate rate-limit buckets. When set, also firewall the
# origin to the proxy's IP ranges.
TRUST_PROXY=1

# Rate limiting on POST /chat (optional — both have working defaults)
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=20

# Concurrent in-flight SSE streams per IP / globally (optional — defaults 3/20)
MAX_CONCURRENT_PER_IP=3
MAX_CONCURRENT_GLOBAL=20

# Daily token budgets for the chat circuit breaker, reset at UTC midnight.
# Counters live in the SQLite session store, so they survive restarts.
DAILY_PER_IP_TOKEN_BUDGET=200000
DAILY_GLOBAL_TOKEN_BUDGET=1000000

# SQLite database file for local development when SESSION_STORE=sqlite.
SESSION_STORE=sqlite
SESSION_DB_PATH=./data/sessions.db

# Set SESSION_STORE=postgres and provide DATABASE_URL only when using Postgres.
# Local development defaults to SQLite and should omit DATABASE_URL.
# Production uses a pooled Neon URL stored as a Fly secret.
DATABASE_URL=

# Cloudflare Access protection for production /admin API routes. Configure an
# Access application for api.matheusgalvao.com/admin/* and allow only your
# email. The API validates the Access JWT itself; unset values fail closed.
ADMIN_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
ADMIN_ACCESS_AUD=your-admin-api-audience-tag
ADMIN_ACCESS_EMAIL=you@example.com

# Shared secret between apps/web and apps/api (optional — unset disables the
# check entirely, so local dev works without it). Not real security, just an
# abuse-deterrent — see packages/config/src/apiKey.ts.
API_KEY=

# Notion sync (used only by scripts/sync-notion.ts, never by the running API)
NOTION_API_KEY=
NOTION_ROOT_PAGE_ID=

# Public contact links (rendered by the web sidebar, served by GET /contact
# and the get_contact_information tool). Use full schemes: mailto: for email,
# https:// for the rest. Unset values simply don't render.
CONTACT_EMAIL=
CONTACT_LINKEDIN=
CONTACT_GITHUB=
